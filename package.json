{
  "name": "wakandans-hr",
  "version": "1.0.0",
  "description": "Human Resources Management System",
  "private": true,
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "husky": "9.1.6"
  },
  "scripts": {
    "start": "sh ./start.sh",
    "format": "sh ./format.sh",
    "seed": "sh ./seed.sh",
    "prepare": "husky",
    "db-api": "npm run --workspace=db-api",
    "jobs": "npm run --workspace=jobs",
    "db:migrate": "docker compose exec db-api npx prisma migrate dev",
    "web-app": "npm run --workspace=web-app"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@typescript-eslint/parser": "^8.14.0"
  }
}
